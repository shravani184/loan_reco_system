# Copy to .env and fill in. .env is gitignored and never committed.
#
# FLAT SCALARS ONLY. Guardrail caps, enumeration grids, diagnostic weights, asset
# haircuts and the suitability threshold are typed defaults in app/config.py, NOT
# here — .env parses nested structures badly. To override the complex block, point
# COMPLEX_CONFIG_PATH at a JSON file.

# --- Versions stamped into every decision trace
CONFIG_VERSION=2.0.0
FEATURE_VERSION=2.0.0
PROMPT_VERSION=2.0.0
LABELING_POLICY_VERSION=2.0.0

# --- Artifact paths
RISK_MODEL_PATH=models/risk_model.json
RECOMMENDER_MODEL_PATH=models/loan_recommender.json
CALIBRATION_KNOTS_PATH=models/loan_recommender_calibration.json
ENCODER_MAPPING_PATH=models/loan_recommender_encoders.json
LOAN_CATALOGUE_PATH=data/loan_products.csv

# --- LLM (explanation only; never computes or decides)
LLM_API_KEY=your-key-here
LLM_API_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=qwen/qwen3.8-27b

# --- Personalization store
PERSONALIZATION_DB_URL=sqlite:///data/personalization.db

# --- Service
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
ENABLE_XAI_ENDPOINT=true

# --- Optional JSON override of the complex config block. Leave blank to use the
#     typed defaults in app/config.py.
COMPLEX_CONFIG_PATH=
